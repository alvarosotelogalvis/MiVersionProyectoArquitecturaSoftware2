  <diagram id="flashtix-c4-l2" name="C4 L2 - Containers">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2060" pageHeight="1650" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="boundary" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#444444;dashed=1;dashPattern=8 5;strokeWidth=1.8;align=left;verticalAlign=bottom;spacingLeft=12;spacingBottom=6;fontColor=#333333;fontSize=12;container=0;" value="&lt;b style=&quot;font-size:16px&quot;&gt;FlashTix&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;i&gt;[Software System]&lt;/i&gt;" vertex="1">
          <mxGeometry height="1040" width="1640" x="123" y="50" as="geometry" />
        </mxCell>
        <mxCell id="saga" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#BBBBBB;fontSize=12;fontColor=#2B2B2B;align=left;verticalAlign=top;spacingLeft=20;spacingTop=12;spacingRight=20;" value="&lt;b style=&quot;font-size:14px&quot;&gt;Checkout SAGA&lt;/b&gt; (orchestrated by Order Service · transactional outbox · at-least-once + idempotent consumers)&lt;br&gt;&lt;br&gt;1. POST /orders + Idempotency-Key → Order Service locks the hold in Reservation (TTL extended to cover the payment) → order PENDING + outbox payment.requested → 202 Accepted.&lt;br&gt;&lt;br&gt;2. Payment Worker consumes payment.requested → Legacy Payment Gateway (timeout 20 s, 3 retries with exponential backoff, circuit breaker, DLQ) → payment.succeeded | payment.failed.&lt;br&gt;&lt;br&gt;3. payment.succeeded → ONE MySQL transaction in booking-db: INSERT sold_seats (UNIQUE event + seat) + order CONFIRMED + outbox order.confirmed.&lt;br&gt;&lt;br&gt;4. order.confirmed → Ticket Service builds PDF + QR (MinIO) and publishes ticket.issued → Notification Worker emails the fan · Catalog refreshes availability · Reservation deletes the hold.&lt;br&gt;&lt;br&gt;5. Compensations: payment.failed → order FAILED + hold released · UNIQUE violation after charging → refund.requested → refund.completed → order CANCELLED." vertex="1">
          <mxGeometry height="245" width="1640" x="200" y="1310" as="geometry" />
        </mxCell>
